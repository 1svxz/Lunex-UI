function library:init_config(window)
    local textbox
    local main = window:Tab({ name = "Configs", icon = "rbxassetid://72506063321241" })
    local section = main:Section({ name = "Settings", side = "right", size = 1, default = true })

    config_holder = section:Dropdown({
        Name = "Configs",
        options = {"report", "this", "error", "to", "finobe"},
        callback = function(option) if textbox then textbox.set(option) end end,
        flag = "config_name_list",
    })
    library:update_config_list()
    textbox = section:Textbox({ name = "Config name:", flag = "config_name_text" })

    section:Button({
        name = "Save",
        callback = function()
            pcall(writefile,
                library.directory .. "/configs/" .. (flags["config_name_text"] or "") .. ".cfg",
                library:get_config())
            library:update_config_list()
        end,
    })
    section:Button({
        name = "Load",
        callback = function()
            pcall(function()
                library:load_config(readfile(library.directory .. "/configs/" .. (flags["config_name_text"] or "") .. ".cfg"))
            end)
            library:update_config_list()
        end,
    })
    section:Button({
        name = "Delete",
        callback = function()
            pcall(delfile, library.directory .. "/configs/" .. (flags["config_name_text"] or "") .. ".cfg")
            library:update_config_list()
        end,
    })
end

--=====================================================================
-- Notifications (touch-tappable)
--=====================================================================
function notifications:refresh_notifs()
    local y = 50
    for _, v in ipairs(notifications.notifs) do
        tween_service:Create(v, TweenInfo.new(1, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
            { Position = dim_offset(20, y) }):Play()
        y = y + v.AbsoluteSize.Y + 10
    end
end

function notifications:fade(path, is_fading)
    local tr = is_fading and 1 or 0
    tween_service:Create(path, TweenInfo.new(0.6, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
        { BackgroundTransparency = tr }):Play()
    for _, instance in ipairs(path:GetDescendants()) do
        if instance:IsA("UIStroke") then
            tween_service:Create(instance, TweenInfo.new(0.6), { Transparency = tr }):Play()
        elseif instance:IsA("TextLabel") or instance:IsA("TextButton") then
            tween_service:Create(instance, TweenInfo.new(0.6), { TextTransparency = tr }):Play()
        elseif instance:IsA("Frame") then
            tween_service:Create(instance, TweenInfo.new(0.6), { BackgroundTransparency = tr }):Play()
        end
    end
end

function notifications:create_notification(options)
    options = options or {}
    local cfg = {
        name = options.name or "Notification",
        color = options.color or rgb(255, 255, 255),
        click = options.click or false,
        duration = options.duration or 5,
    }

    local outline = library:create("TextButton", {
        Parent = library.items,
        Size = dim2(0, 0, 0, 0),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "",
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundColor3 = rgb(46, 46, 46),
    })
    local inline = library:create("Frame", {
        Parent = outline,
        Position = dim2(0, 1, 0, 1),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundColor3 = rgb(21, 21, 21),
    })
    library:create("UIPadding", {
        PaddingTop = dim(0, 7), PaddingBottom = dim(0, 6),
        PaddingRight = dim(0, 8), PaddingLeft = dim(0, 4),
        Parent = inline,
    })
    local misc_text = library:create("TextLabel", {
        FontFace = library.font,
        Parent = inline,
        LineHeight = 1.75,
        TextColor3 = rgb(255, 255, 255),
        Text = cfg.name,
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = dim2(1, -4, 1, 0),
        Position = dim2(0, 4, 0, -2),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        BorderSizePixel = 0,
        TextSize = IS_TOUCH and 12 or 10,
        ZIndex = 2,
    })
    library:create("UIPadding", { PaddingBottom = dim(0, 1), PaddingRight = dim(0, 1), Parent = outline })

    local line = library:create("Frame", {
        Parent = outline,
        Position = dim2(0, 1, 1, -1),
        Size = dim2(0, 0, 0, 1),
        BorderSizePixel = 0,
        BackgroundColor3 = cfg.color,
    })
    library:create("Frame", {
        Parent = outline,
        Position = dim2(0, 1, 0, 1),
        Size = dim2(0, 1, 1, -1),
        BorderSizePixel = 0,
        BackgroundColor3 = cfg.color,
    })

    local index = #notifications.notifs + 1
    notifications.notifs[index] = outline
    notifications:refresh_notifs()
    outline.Position = dim2(0, 20, 0, 200)

    task.spawn(function()
        tween_service:Create(line, TweenInfo.new(3, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
            { Size = dim2(1, -1, 0, 1) }):Play()
        task.wait(cfg.duration)
        notifications.notifs[index] = nil
        for _, obj in ipairs(outline:GetDescendants()) do
            if obj:IsA("Frame") or obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                library:fade(obj, "BackgroundTransparency", false, 0.6)
            elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
                library:fade(obj, "TextTransparency", false, 0.6)
            elseif obj:IsA("UIStroke") then
                library:fade(obj, "Transparency", false, 0.6)
            end
        end
        task.wait(0.7)
        outline:Destroy()
        notifications:refresh_notifs()
    end)

    -- Tap to dismiss on mobile, click on desktop
    outline.InputBegan:Connect(function(input)
        if not is_primary(input) then return end
        notifications.notifs[index] = nil
        outline:Destroy()
        notifications:refresh_notifs()
    end)
end


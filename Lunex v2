--=====================================================================
-- Input helpers (the mobile core of this adaptation)
--=====================================================================
local function is_primary(input)
    -- A "press" is either a mouse button or a touch.
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function is_move(input)
    -- A "move" is either a mouse move or a touch drag.
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

-- Pointer location in viewport coordinates, for both mouse and touch.
local function pointer_position()
    local p = uis:GetMouseLocation()
    return vec2(p.X, p.Y - gui_offset)
end


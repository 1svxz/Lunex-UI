local function SpawnRipple(parent, input)
    if not parent or not parent.Parent then return end
    local absPos = parent.AbsolutePosition
    local absSz  = parent.AbsoluteSize
    local clickX = (input.Position.X - absPos.X)
    local clickY = (input.Position.Y - absPos.Y)
    local prevClip = parent.ClipsDescendants
    parent.ClipsDescendants = true

    local Ripple = Instance.new("Frame")
    Ripple.Name = "Ripple"
    Ripple.AnchorPoint = Vector2.new(0.5, 0.5)
    Ripple.Position = UDim2.fromOffset(clickX, clickY)
    Ripple.Size = UDim2.fromOffset(0, 0)
    Ripple.BackgroundColor3 = Library.Theme.Accent
    Ripple.BackgroundTransparency = 0.35
    Ripple.BorderSizePixel = 0
    Ripple.ZIndex = (parent.ZIndex or 1) + 5
    Ripple.Parent = parent
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = Ripple

    local maxDim = math.max(absSz.X, absSz.Y) * 2.6
    local tw = TweenService:Create(
        Ripple,
        TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { Size = UDim2.fromOffset(maxDim, maxDim), BackgroundTransparency = 1 }
    )
    tw:Play()
    tw.Completed:Connect(function()
        if Ripple and Ripple.Parent then Ripple:Destroy() end
        if parent and parent.Parent then parent.ClipsDescendants = prevClip end
    end)
end
Library.SpawnRipple = SpawnRipple


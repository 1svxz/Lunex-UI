        size   = properties.size or properties.Size or dim2(0, 650, 0, 400),
        logo   = properties.logo or properties.Logo or "rbxassetid://128155293790451",
        selected_tab = nil,
        items  = {},
        tweening = false,
    }

    -- Clamp size to viewport (mobile screens are small)
    do

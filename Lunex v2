        flag = options.flag or options.Flag or options.name or "please_set_a_flag",
        callback = options.callback or options.Callback or function() end,
        show_value = options.ShowValue or options.show_value or true,
        min = options.min or options.minimum or options.Min or options.Minimum or 0,
        max = options.max or options.maximum or options.Max or options.Maximum or 100,
        intervals = options.interval or options.decimal or options.Interval or options.Decimal or 1,
        default = options.default or options.Default or 10,
        value = options.default or 10,
        dragging = false,
        items = {},
    }

    local items = cfg.items
    items.object = library:create("Frame", {
        Parent = self.items.object or self.items.elements,
        BackgroundTransparency = 1,
        Size = dim2(0, 0, 0, IS_TOUCH and 20 or 12),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.XY,
    })

    library:create("UIListLayout", {
        Parent = items.object,
        Padding = dim(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
    })

    items.slider_parent = library:create("TextButton", {
        Parent = items.object,
        BackgroundTransparency = 1,
        Text = "",
        Size = dim2(0, 100, 1, 0),
        BorderSizePixel = 0,
    })

    items.slider_holder = library:create("Frame", {
        AnchorPoint = vec2(0, 0.5),
        Parent = items.slider_parent,
        Position = dim2(0, 0, 0.5, 0),
        Size = dim2(1, 0, 0, IS_TOUCH and 10 or 5),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(0, 0, 0),
    })

    items.gradient_holder = library:create("Frame", {
        Parent = items.slider_holder,
        Position = dim2(0, 1, 0, 1),
        Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255),
    })

    library:create("UIGradient", {
        Color = rgbseq{ rgbkey(0, rgb(255, 255, 255)), rgbkey(1, rgb(93, 93, 93)) },
        Parent = items.gradient_holder,
    })

    items.slider = library:create("Frame", {
        AnchorPoint = vec2(0, 0.5),
        Parent = items.gradient_holder,
        Position = dim2(0, 0, 0.5, 0),
        Size = dim2(0, 4, 0, IS_TOUCH and 16 or 9),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(0, 0, 0),
    })

    items.inline = library:create("Frame", {
        Parent = items.slider,
        Position = dim2(0, 1, 0, 1),
        Size = dim2(1, -2, 1, -2),
        BorderSizePixel = 0,
        BackgroundColor3 = rgb(255, 255, 255),
    })

    if cfg.name then items.name = setmetatable(cfg, library):Label({ Name = cfg.name, padding_top = 1 }) end
    if cfg.show_value then items.value = setmetatable(cfg, library):Label({ padding_top = 1 }) end

    function cfg.set(value)
        cfg.value = clamp(library:round(value, cfg.intervals), cfg.min, cfg.max)
        items.slider.Position = dim2((cfg.value - cfg.min) / (cfg.max - cfg.min), 0, 0.5, 0)
        if items.value then items.value.set(tostring(cfg.value) .. cfg.suffix) end
        flags[cfg.flag] = cfg.value
        cfg.callback(flags[cfg.flag])
    end

    local active_input = nil
    local function begin(input)
        if not is_primary(input) then return end
        cfg.dragging = true
        active_input = input
        -- Jump to tap position immediately (essential on mobile)
        local rel = (input.Position.X - items.gradient_holder.AbsolutePosition.X)
                  / items.gradient_holder.AbsoluteSize.X
        cfg.set(((cfg.max - cfg.min) * clamp(rel, 0, 1)) + cfg.min)
    end

    items.slider_parent.InputBegan:Connect(begin)

    library:connection(uis.InputChanged, function(input)
        if not cfg.dragging then return end
        if input ~= active_input and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        if not is_move(input) then return end
        local rel = (input.Position.X - items.gradient_holder.AbsolutePosition.X)
                  / items.gradient_holder.AbsoluteSize.X
        cfg.set(((cfg.max - cfg.min) * clamp(rel, 0, 1)) + cfg.min)
    end)

    library:connection(uis.InputEnded, function(input)
        if input == active_input
            or input.UserInputType == Enum.UserInputType.MouseButton1
            or (input.UserInputType == Enum.UserInputType.Touch and not input ~= active_input) then
            cfg.dragging = false
            active_input = nil
        end
    end)

    cfg.set(cfg.default)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


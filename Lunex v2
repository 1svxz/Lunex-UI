--=====================================================================
-- Utility functions
--=====================================================================
function library:tween(obj, properties, easing_style, time)
    local tween = tween_service:Create(
        obj,
        TweenInfo.new(time or 0.25, easing_style or Enum.EasingStyle.Quint, Enum.EasingDirection.InOut),
        properties
    )
    tween:Play()
    return tween
end

function library:create(instance, options)
    local ins = Instance.new(instance)
    for prop, value in pairs(options) do
        ins[prop] = value
    end
    return ins
end

function library:connection(signal, callback)
    local connection = signal:Connect(callback)
    insert(library.connections, connection)
    return connection
end

function library:get_transparency(obj)
    if obj:IsA("Frame") then
        return { "BackgroundTransparency" }
    elseif obj:IsA("TextLabel") or obj:IsA("TextButton") then
        return { "TextTransparency", "BackgroundTransparency" }
    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
        return { "BackgroundTransparency", "ImageTransparency" }
    elseif obj:IsA("ScrollingFrame") then
        return { "BackgroundTransparency", "ScrollBarImageTransparency" }
    elseif obj:IsA("TextBox") then
        return { "TextTransparency", "BackgroundTransparency" }
    elseif obj:IsA("UIStroke") then
        return { "Transparency" }
    end
    return nil
end

function library:fade(obj, prop, vis, speed)
    if not (obj and prop) then return end
    local old = obj[prop]
    obj[prop] = vis and 1 or old
    local tw = library:tween(obj, { [prop] = vis and old or 1 }, nil, speed)
    library:connection(tw.Completed, function()
        if not vis then
            task.wait()
            obj[prop] = old
        end
    end)
    return tw
end

function library:round(number, float)
    local multiplier = 1 / (float or 1)
    return floor(number * multiplier + 0.5) / multiplier
end

function library:convert(str)
    local values = {}
    for value in string.gmatch(str, "[^,]+") do
        insert(values, tonumber(value))
    end
    if #values == 4 then return unpack(values) end
end

function library:convert_enum(enum)
    local enum_parts = {}
    for part in string.gmatch(enum, "[%w_]+") do
        insert(enum_parts, part)
    end
    local enum_table = Enum
    for i = 2, #enum_parts do
        enum_table = enum_table[enum_parts[i]]
    end
    return enum_table
end

-- Pointer-in-frame test that works for mouse AND touch.
function library:mouse_in_frame(uiobject)
    if not (uiobject and uiobject.Parent) then return false end
    local p = pointer_position()
    local ap, as = uiobject.AbsolutePosition, uiobject.AbsoluteSize
    return p.X >= ap.X and p.X <= ap.X + as.X
       and p.Y >= ap.Y and p.Y <= ap.Y + as.Y
end

function library:close_current_element(cfg)
    local path = library.current
    if path and path ~= cfg and path.set_visible then
        path.set_visible(false)
        path.open = false
    end
end

--=====================================================================
-- Window dragging (touch + mouse)
--=====================================================================
function library:draggify(frame)
    local dragging = false
    local start_pos, start_size
    -- track the exact input object we began with so multitouch doesn't
    -- hijack the drag
    local active_input = nil

    local function begin(input)
        if not is_primary(input) then return end
        dragging     = true
        active_input = input
        start_pos    = input.Position
        start_size   = frame.Position
    end

    local function finish(input)
        if active_input == input or not active_input then
            dragging     = false
            active_input = nil
        end
    end

    frame.InputBegan:Connect(begin)
    frame.InputEnded:Connect(finish)

    library:connection(uis.InputChanged, function(input)
        if not dragging then return end
        -- Accept movement for either the same input (touch) or a mouse move
        if input ~= active_input
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        if not is_move(input) then return end

        local vp = camera.ViewportSize
        local dx = input.Position.X - start_pos.X
        local dy = input.Position.Y - start_pos.Y
        frame.Position = dim2(
            0, clamp(start_size.X.Offset + dx, 0, vp.X - frame.Size.X.Offset),
            0, clamp(start_size.Y.Offset + dy, 0, vp.Y - frame.Size.Y.Offset)
        )
        library:close_current_element(nil)
    end)

    library:connection(uis.InputEnded, function(input)
        if active_input and input == active_input then
            dragging     = false
            active_input = nil
        end
    end)
end

--=====================================================================
-- Window resizing (touch + mouse)
--=====================================================================
function library:resizify(frame)
    local handle = library:create("TextButton", {
        Position            = dim2(1, -10, 1, -10),
        BorderColor3        = rgb(0, 0, 0),
        Size                = dim2(0, 22, 0, 22), -- larger touch target
        BorderSizePixel     = 0,
        BackgroundColor3    = rgb(255, 255, 255),
        BackgroundTransparency = 1,
        Text                = "",
        Parent              = frame,
    })

    local resizing   = false
    local start_size, start
    local og_size    = frame.Size
    local active_input = nil

    handle.InputBegan:Connect(function(input)
        if not is_primary(input) then return end
        resizing     = true
        active_input = input
        start        = input.Position
        start_size   = frame.Size
    end)
    handle.InputEnded:Connect(function(input)
        if active_input == input then
            resizing     = false
            active_input = nil
        end
    end)

    library:connection(uis.InputChanged, function(input)
        if not resizing then return end
        if input ~= active_input
            and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        if not is_move(input) then return end

        local vp = camera.ViewportSize
        frame.Size = dim2(
            start_size.X.Scale,
            clamp(start_size.X.Offset + (input.Position.X - start.X), og_size.X.Offset, vp.X),
            start_size.Y.Scale,
            clamp(start_size.Y.Offset + (input.Position.Y - start.Y), og_size.Y.Offset, vp.Y)
        )
    end)

    library:connection(uis.InputEnded, function(input)
        if active_input and input == active_input then
            resizing     = false
            active_input = nil
        end
    end)
end

--=====================================================================
-- Config helpers
--=====================================================================
local config_holder
function library:update_config_list()
    if not config_holder then return end
    if not listfiles then return end
    local list = {}
    pcall(function()
        for _, file in ipairs(listfiles(library.directory .. "/configs")) do
            local name = file:gsub(library.directory .. "/configs\\", ""):gsub(".cfg", ""):gsub(library.directory .. "\\configs\\", "")
            list[#list + 1] = name
        end
    end)
    config_holder.refresh_options(list)
end

function library:get_config()
    local Config = {}
    for k, v in pairs(flags) do
        if type(v) == "table" and v.key then
            Config[k] = { active = v.active, mode = v.mode, key = tostring(v.key) }
        elseif type(v) == "table" and v["Transparency"] and v["Color"] then
            Config[k] = { Transparency = v["Transparency"], Color = v["Color"]:ToHex() }
        else
            Config[k] = v
        end
    end
    return http_service:JSONEncode(Config)
end

function library:load_config(config_json)
    local config = http_service:JSONDecode(config_json)
    for k, v in pairs(config) do
        if k == "config_name_list" then continue end
        local setter = config_flags[k]
        if setter then
            if type(v) == "table" and v["Transparency"] and v["Color"] then
                pcall(setter, hex(v["Color"]), v["Transparency"])
            else
                pcall(setter, v)
            end
        end
    end
end

function library:unload_menu()
    if library.items then library.items:Destroy() end
    if library.other then library.other:Destroy() end
    if library.float_toggle then library.float_toggle:Destroy() end
    for _, connection in ipairs(library.connections) do
        connection:Disconnect()
    end
    library.connections = {}
end


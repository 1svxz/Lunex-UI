        Position = dim2(0, 20, 0, 5),
        BorderSizePixel = 0,
        AutomaticSize = Enum.AutomaticSize.XY,
        TextSize = IS_TOUCH and 12 or 10,
    })

    function cfg.set_visible(bool)
        items.colorpicker_outline.Visible = bool
        local ap = items.gear_holder.AbsolutePosition
        items.colorpicker_outline.Position = dim2(0, ap.X - 5, 0, ap.Y + items.gear_holder.AbsoluteSize.Y + 4)
        library.current = cfg
    end

    function cfg.set(clr, alpha)
        if clr then h, s, v = clr:ToHSV() end
        if alpha then a = alpha end
        local Color = Color3.fromHSV(h, s, v)
        items.hue_picker.Position   = dim2(0, -1, 1 - h, -1)
        items.alpha_picker.Position = dim2(1 - a, -1, 0, -1)
        items.satval_picker.Position = dim2(s, -1, 1 - v, -1)
        items.color_saturation.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        items.visualizer.BackgroundColor3 = Color
        flags[cfg.flag] = { Color = Color, Transparency = a }
        cfg.callback(Color, a)
    end

    -- Reads touch position if available, else mouse.
    local function read_pointer()
        local p = pointer_position()
        return p
    end

    function cfg.update_color()
        local p = read_pointer()
        if dragging_sat then
            s = clamp((p.X - items.sat.AbsolutePosition.X) / items.sat.AbsoluteSize.X, 0, 1)
            v = 1 - clamp((p.Y - items.val.AbsolutePosition.Y) / items.val.AbsoluteSize.Y, 0, 1)
        elseif dragging_hue then
            h = 1 - clamp((p.Y - items.hue_slider.AbsolutePosition.Y) / items.hue_slider.AbsoluteSize.Y, 0, 1)
        elseif dragging_alpha then
            a = 1 - clamp((p.X - items.alpha_slider.AbsolutePosition.X) / items.alpha_slider.AbsoluteSize.X, 0, 1)
        end
        cfg.set(nil, nil)
    end

    items.gear_holder.InputBegan:Connect(function(input)
        if is_primary(input) then cfg.set_visible(not items.colorpicker_outline.Visible) end
    end)

    -- Colourpicker internal drag: accept touch + mouse
    local function begin_drag(kind)
        return function(input)
            if not is_primary(input) then return end
            if kind == "sat"   then dragging_sat = true
            elseif kind == "hue"   then dragging_hue = true
            elseif kind == "alpha" then dragging_alpha = true end
            active_input = input
            cfg.update_color()
        end
    end
    items.saturation_outline.InputBegan:Connect(begin_drag("sat"))
    items.hue_slider.InputBegan:Connect(begin_drag("hue"))
    items.alpha_slider.InputBegan:Connect(begin_drag("alpha"))

    library:connection(uis.InputChanged, function(input)
        if not (dragging_sat or dragging_hue or dragging_alpha) then return end
        if input ~= active_input and input.UserInputType ~= Enum.UserInputType.MouseMovement then
            return
        end
        if not is_move(input) then return end
        cfg.update_color()
    end)

    library:connection(uis.InputEnded, function(input)
        if input ~= active_input
            and input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        dragging_sat, dragging_hue, dragging_alpha = false, false, false
        active_input = nil
        if not (library:mouse_in_frame(items.gear_holder) or library:mouse_in_frame(items.colorpicker_outline)) then
            cfg.open = false
            cfg.set_visible(false)
        end
    end)

    cfg.set(cfg.color, cfg.alpha)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


                local Obj = {
                    Get = function() return selected end,
                    Set = function(v) selected = v; ValueLabel.Text = tostring(v); UpdateList() end,
                    Refresh = function(new) UpdateList(new) end
                }
                Library.Flags[dopts.Flag or dopts.Name] = Obj
                return Obj
            end

            function Section:PlayerList(popts)
                popts = popts or {}
                local showDistance = popts.ShowDistance or false
                local refreshRate  = popts.RefreshRate  or 0.5
                local detailHeight = popts.DetailHeight or 100
                local rowHeight    = 17
                local blockHeight  = popts.Height or 400

                local Meta = {}
                local SelectedPlayer = nil
                local function getMeta(p)
                    if not Meta[p] then Meta[p] = { prioritize = false, friendly = false, spectate = false } end
                    return Meta[p]
                end

                local Block = Create("Frame", {
                    Name = "PlayerListBlock",
                    Size = fill and UDim2.new(1, 0, 1, 0) or UDim2.new(1, 0, 0, blockHeight),
                    BackgroundTransparency = 1, ZIndex = 6, Parent = ElementList,
                })
                local ListHolder = Create("ScrollingFrame", {
                    Name = "Players",
                    Size = UDim2.new(1, 0, 1, -(detailHeight + 6)),
                    Position = UDim2.new(0, 0, 0, 0),
                    BackgroundTransparency = 1, BorderSizePixel = 0,
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2, ScrollBarImageColor3 = Library.Theme.Accent,
                    ZIndex = 6, Parent = Block,
                })
                table.insert(Library.Elements.PlayerListScrolls, ListHolder)
                Create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0), Parent = ListHolder })

                local DetailPanel = Create("Frame", {
                    Name = "DetailPanel", Size = UDim2.new(1, 0, 0, detailHeight),
                    Position = UDim2.new(0, 0, 1, -detailHeight),
                    BackgroundColor3 = Library.Theme.Background,
                    BorderSizePixel = 0, ZIndex = 7, Parent = Block,
                })
                ApplyCelestiteStyle(DetailPanel)
                table.insert(Library.Elements.PlayerListDetails, DetailPanel)

                local Thumb = Create("ImageLabel", {
                    Name = "Thumb", Size = UDim2.new(0, 64, 0, 64),
                    Position = UDim2.new(0, 6, 0, 6),
                    BackgroundColor3 = Library.Theme.SectionBackground,
                    BorderSizePixel = 0, Image = "", ScaleType = Enum.ScaleType.Crop,
                    ZIndex = 9, Parent = DetailPanel,
                })
                AddOutline(Thumb)
                table.insert(Library.Elements.PlayerListThumbs, Thumb)

                local InfoHolder = Create("Frame", {
                    Name = "Info", BackgroundTransparency = 1,
                    Position = UDim2.new(0, 76, 0, 4),
                    Size = UDim2.new(1, -156, 1, -8), ZIndex = 9, Parent = DetailPanel,
                })
                local function mkInfoRow(idx)
                    local row = Create("TextLabel", {
                        Text = "", Size = UDim2.new(1, 0, 0, 14),
                        Position = UDim2.new(0, 0, 0, (idx - 1) * 15),
                        BackgroundTransparency = 1, FontFace = true,
                        TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Center,
                        ZIndex = 10, Parent = InfoHolder,
                        TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                    })
                    table.insert(Library.Elements.PlayerListInfoLabels, row)
                    return row
                end
                local IdRow   = mkInfoRow(1)
                local NameRow = mkInfoRow(2)
                local UserRow = mkInfoRow(3)
                local AgeRow  = mkInfoRow(4)

                local ButtonsCol = Create("Frame", {
                    Name = "Buttons", BackgroundTransparency = 1,
                    Position = UDim2.new(1, -84, 0, 6),
                    Size = UDim2.new(0, 78, 1, -12), ZIndex = 9, Parent = DetailPanel,
                })
                Create("UIListLayout", {
                    FillDirection = Enum.FillDirection.Vertical,
                    VerticalAlignment = Enum.VerticalAlignment.Top,
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 4), Parent = ButtonsCol,
                })
                local function mkActionBtn(text, order)
                    local Btn = Create("TextButton", {
                        Text = "", Size = UDim2.new(1, 0, 0, 38),
                        BackgroundColor3 = Library.Theme.SectionBackground,
                        BorderSizePixel = 0, AutoButtonColor = false,
                        LayoutOrder = order, ZIndex = 10,
                        Parent = ButtonsCol, ClipsDescendants = true,
                    })
                    ApplyCelestiteStyle(Btn)
                    Create("TextLabel", {
                        Text = text, Size = UDim2.new(1, 0, 1, 0),
                        BackgroundTransparency = 1, FontFace = true,
                        TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Center,
                        TextYAlignment = Enum.TextYAlignment.Center,
                        ZIndex = 11, Parent = Btn,
                        TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                    })
                    table.insert(Library.Elements.Buttons, Btn)
                    Btn.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                            SpawnRipple(Btn, input)
                        end
                    end)
                    return Btn
                end
                local TPBtn       = mkActionBtn("TP", 1)
                local SpectateBtn = mkActionBtn("Spectate", 2)

                local spectating = false
                local function setSpectateVisual(state)
                    spectating = state
                    SpectateBtn.BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.SectionBackground
                end
                table.insert(Library.Elements.PlayerListActionBtns, {
                    Btn = SpectateBtn,
                    IsActive = function() return spectating end,
                })

                local function UpdateDetail(player)
                    if not player or not player.Parent then
                        Thumb.Image = ""
                        IdRow.Text = "Id : -"; NameRow.Text = "Display Name : -"
                        UserRow.Text = "Name : -"; AgeRow.Text = "Account Age : -"
                        return
                    end
                    Thumb.Image  = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=150&h=150"
                    IdRow.Text   = "Id : " .. player.UserId
                    NameRow.Text = "Display Name : " .. (player.DisplayName or player.Name)
                    UserRow.Text = "Name : " .. player.Name
                    AgeRow.Text  = "Account Age : " .. (player.AccountAge or 0)
                    local m = getMeta(player)
                    setSpectateVisual(m.spectate == true)
                end

                local Rows = {}
                local function CreateRow(player)
                    local row = Create("Frame", {
                        Name = player.Name, Size = UDim2.new(1, 0, 0, rowHeight),
                        BackgroundColor3 = Library.Theme.DarkBackground,
                        BorderSizePixel = 0, ZIndex = 6, Parent = ListHolder,
                    })
                    local nameL = Create("TextLabel", {
                        Text = player.Name, Size = UDim2.new(1, -100, 1, 0),
                        Position = UDim2.new(0, 6, 0, 0),
                        BackgroundTransparency = 1, FontFace = true,
                        TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.Text,
                        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7, Parent = row,
                        TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                    })
                    local statusL = Create("TextLabel", {
                        Text = "None", Size = UDim2.new(0, 90, 1, 0),
                        Position = UDim2.new(1, -94, 0, 0),
                        BackgroundTransparency = 1, FontFace = true,
                        TextSize = Library.Config.FontSize, TextColor3 = Library.Theme.InactiveText,
                        TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 7, Parent = row,
                        TextStrokeTransparency = 0, TextStrokeColor3 = Color3.fromRGB(0, 0, 0),
                    })
                    local divider = Create("Frame", {
                        Size = UDim2.new(1, 0, 0, 1),
                        Position = UDim2.new(0, 0, 1, -1),
                        BackgroundColor3 = Library.Theme.Inline,
                        BorderSizePixel = 0, ZIndex = 7, Parent = row,
                    })
                    table.insert(Library.Elements.PlayerListDividers, divider)
                    local click = Create("TextButton", {
                        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1,
                        Text = "", TextTransparency = 1, AutoButtonColor = false,
                        ZIndex = 8, Parent = row,
                    })
                    click.MouseButton1Click:Connect(function()
                        SelectedPlayer = player
                        UpdateDetail(player)
                        for p, r in pairs(Rows) do
                            r.Row.BackgroundColor3 = (p == player)
                                and Library.Theme.SectionBackground
                                or  Library.Theme.DarkBackground
                        end
                    end)
                    local entry = { Row = row, Name = nameL, Status = statusL, Divider = divider }
                    table.insert(Library.Elements.PlayerListRows, entry)
                    return entry
                end

                local function Refresh()
                    local players = Players:GetPlayers()
                    table.sort(players, function(a, b)
                        local aLocal = (a == Players.LocalPlayer)
                        local bLocal = (b == Players.LocalPlayer)
                        if aLocal ~= bLocal then return aLocal end
                        return a.Name:lower() < b.Name:lower()
                    end)
                    for player, data in pairs(Rows) do
                        if not player.Parent or not table.find(players, player) then
                            data.Row:Destroy(); Rows[player] = nil
                            if SelectedPlayer == player then
                                SelectedPlayer = Players.LocalPlayer
                                UpdateDetail(SelectedPlayer)
                            end
                        end
                    end
                    for i, player in ipairs(players) do
                        local data = Rows[player]
                        if not data then
                            data = CreateRow(player); Rows[player] = data
                        end
                        data.Row.LayoutOrder = i
                        data.IsLocal = (player == Players.LocalPlayer)
                        data.Name.Text = player.Name
                        if data.IsLocal then
                            data.Status.Text = "Local Player"
                            data.Status.TextColor3 = Library.Theme.Accent
                        elseif showDistance then
                            local lp   = Players.LocalPlayer
                            local lhrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
                            local thrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            data.Status.Text = (lhrp and thrp)
                                and (math.floor((thrp.Position - lhrp.Position).Magnitude) .. "m")
                                or  "None"
                            data.Status.TextColor3 = Library.Theme.InactiveText
                        else
                            data.Status.Text = "None"
                            data.Status.TextColor3 = Library.Theme.InactiveText
                        end
                        data.Row.BackgroundColor3 = (player == SelectedPlayer)
                            and Library.Theme.SectionBackground
                            or  Library.Theme.DarkBackground
                    end
                    ListHolder.CanvasSize = UDim2.new(0, 0, 0, #players * rowHeight)
                end

                SelectedPlayer = Players.LocalPlayer
                Refresh()
                UpdateDetail(SelectedPlayer)

                local c1 = Players.PlayerAdded:Connect(Refresh)
                local c2 = Players.PlayerRemoving:Connect(Refresh)

                local running = true
                task.spawn(function()
                    while running and Block.Parent do
                        Refresh()
                        task.wait(refreshRate)
                    end
                end)

                TPBtn.MouseButton1Click:Connect(function()
                    if not SelectedPlayer or not SelectedPlayer.Parent then return end
                    if popts.OnTeleport then popts.OnTeleport(SelectedPlayer) end
                end)
                SpectateBtn.MouseButton1Click:Connect(function()
                    if not SelectedPlayer or not SelectedPlayer.Parent then return end
                    local m = getMeta(SelectedPlayer)
                    m.spectate = not m.spectate
                    setSpectateVisual(m.spectate)
                    if popts.OnSpectate then popts.OnSpectate(SelectedPlayer, m.spectate) end
                end)

                return {
                    Refresh      = Refresh,
                    GetSelected  = function() return SelectedPlayer end,
                    SetSelected  = function(p) SelectedPlayer = p; UpdateDetail(p); Refresh() end,
                    GetMeta      = function(p) return Meta[p] end,
                    Destroy      = function()
                        running = false
                        if c1 then c1:Disconnect() end
                        if c2 then c2:Disconnect() end
                        Block:Destroy()
                    end,
                }
            end

            return Section
        end


--[[
	yo so this is my setup for Lunex
	i've been using this lib for a bit now and honestly it's the cleanest one
	i've touched in a while. figured i'd write out a full example with the way
	i actually use it, not the sterile "docs" version.

	fair warning: i ramble. skip to the tabs if you just want code.

	the way i build scripts: i create every UI element FIRST, get them looking
	right, and only THEN wire up the logic. sounds backwards but it saves me
	from chasing bugs in two places at once. you'll see me do that below.
]]

-- grab the lib. swap the url for whatever you're hosting it on
local Lunex = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/1svxz/Lunex-UI/refs/heads/main/Lunex%20v2"
))()

-- standard services. nothing fancy
local Players    = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting   = game:GetService("Lighting")
local UIS        = game:GetService("UserInputService")
local LP         = Players.LocalPlayer

--[[
	before you make the window, set the config folder. everything
	gets saved as plaintext .cfg files in here.
	default is "lunex", but u can rename it to ur liking.
]]
Lunex:SetConfigFolder("Lunex")


--=================================================================
-- WINDOW
--=================================================================
--[[
	Lunex:Window(title) — that's it. just a title.
	there's an optional second arg for size but honestly the default
	620x460 is fine unless you're cramming a ton of stuff in.

	i see people add 20 pixels "for breathing room" and then complain
	the window is too big. just use the default.
]]
local Window = Lunex:Window("Lunex  |  demo")


--=================================================================
-- THE FLOATING BITS (watermark, toggle button, notifs)
--=================================================================
--[[
	these three things are the little quality-of-life touches that
	make a hub feel "finished" instead of "some script i found":

	1. the watermark in the top right — that passive info thing
	2. the toggle button in the top left — shows/hides the whole menu
	3. notifications — those little toasts for feedback

	i always turn all three on. players expect them at this point.
]]

-- watermark. auto-sizes to whatever text you give it
Window:SetWatermarkText("Lunex  |  demo")
Window:SetWatermarkVisible(true)

-- floating toggle. click it to hide/show everything
-- (yes it's draggable, yes that's cool)
Window:SetToggleButtonText("UI Toggle")

-- overrides the game name shown in the bottom bar
-- (normally it fetches the place name automatically, but sometimes
--  you're on a private server and it says "Loading..." forever)
Window:SetGameName("Demo Place")

-- first notification. feels good to greet the user, y'know?
Lunex:Notification({ Text = "Loaded. Have fun.", Duration = 4 })


--=================================================================
-- TABS
--=================================================================
--[[
	here's the thing about tabs that took me a while to internalize:

	every tab has THREE columns — Left, Right, Full.

	- Left  and Right are 50% wide each. use them when you want
	  two vertical stacks of controls side by side.
	- Full  is 100% wide. use it for player lists or anything big.

	THE RULE (and i've broken this so many times):
	don't mix Full with Left/Right in the SAME tab.
	Full sits on top of the other two and you get a visual mess.

	Left + Right? fine.
	Just Full? fine.
	Left + Right + Full? broken.
	Simple.

	i usually split mine like this:
	  Main       — Left + Right (combat / movement)
	  Visuals    — Left + Right (world / player ESP)
	  Players    — Full (the player list)
	  Configs    — Full (own tab, config-only)
	  Theme      — Full (own tab, theme-only)
]]

local MainTab    = Window:Tab("Main")
local VisualsTab = Window:Tab("Visuals")
local PlayersTab = Window:Tab("Players")
local ConfigTab  = Window:Tab("Configs")
local ThemeTab   = Window:Tab("Theme")


--=================================================================
-- MAIN TAB
--=================================================================
--[[
	i split the main tab into two columns:
	  Left  = combat stuff
	  Right = movement stuff

	Side-by-side feels balanced. also lets players tweak both without
	scrolling forever.
]]

-- ── LEFT: combat ──
local Combat = MainTab:Section("Combat", "Left")

--[[
	TOGGLE. the bread and butter.
	  Name     — the label
	  Default  — false by default (obviously pass true if you want it on)
	  Flag     — the KEY it registers under in Library.Flags
	  Callback — fires every time the state flips

	i usually leave Callback out during the "build the UI" phase and
	add it later. keeps things tidy.

	pro tip: always give your toggles a Flag. even if you think you
	won't need to control it from code, you will. every time.
]]
Combat:Toggle({
	Name = "Aimbot",
	Default = false,
	Flag = "aimbotEnabled",
	Callback = function(state)
		print("[aimbot]", state and "on" or "off")
	end,
}):Keybind({ Default = Enum.KeyCode.X })

--[[
	:Keybind() chains onto a toggle and adds a little box on the right
	you click the box, press a key, done. clicking the box again with
	"esc" clears it.

	by default pressing the bound key just toggles the parent toggle.
	you can override that with OnTrigger if you want custom behavior.
	i rarely do. the default is what i want 95% of the time.
]]

Combat:Toggle({
	Name = "Silent Aim",
	Default = false,
	Flag = "silentAim",
}):Keybind({ Default = Enum.KeyCode.Q })

--[[
	CHAINING. :Keybind() returns the toggle itself, so you can chain
	more methods right after it. and :ColorPicker() does the same.

	this next one has a keybind AND a color picker AND is still just
	one toggle. the picker shows up next to the keybind box.
]]
Combat:Toggle({
	Name = "Hit Marker",
	Default = false,
	Flag = "hitMarker",
})
	:Keybind({ Default = Enum.KeyCode.H })
	:ColorPicker({
		Default = Color3.fromRGB(255, 80, 80),
		Callback = function(c) print("[hit marker color]", c) end,
	})

--[[
	you can ALSO attach two or more color pickers if you want a gradient
	style thing (say, tracer start color + tracer end color). they stack
	left-to-right on the right side of the row.
]]
Combat:Toggle({
	Name = "Team Colors",
	Default = false,
	Flag = "teamColors",
})
	:ColorPicker({ Default = Color3.fromRGB(80, 140, 255) })  -- team A
	:ColorPicker({ Default = Color3.fromRGB(255, 80, 80) })   -- team B

--[[
	SLIDER.
	  Min / Max — required
	  Default   — defaults to Min if you skip it

	the number to the right is an editable text box. click it, type
	a value, press enter — that's a way better UX than draggable-only.

	watch out: sliders floor to integers. if you need decimals, scale
	your values (0-100 mapped to 0.0-1.0 or whatever).
]]
Combat:Slider({
	Name = "FOV Radius",
	Min = 0, Max = 720, Default = 120,
	Flag = "fov",
	Callback = function(v) print("[fov]", v) end,
})

-- ── RIGHT: movement ──
local Movement = MainTab:Section("Movement", "Right")

Movement:Toggle({
	Name = "Speed Hack",
	Default = false,
	Flag = "speedHack",
}):Keybind({ Default = Enum.KeyCode.LeftShift })

Movement:Slider({
	Name = "Walk Speed",
	Min = 16, Max = 250, Default = 32,
	Flag = "walkspeed",
})

--[[
	guess what, sliders can be side-by-side with toggles, labels,
	whatever. the section just stacks them vertically with tiny
	4px gaps. you don't need to think about it.
]]
Movement:Slider({
	Name = "Jump Power",
	Min = 50, Max = 500, Default = 100,
	Flag = "jumppower",
})

Movement:Toggle({
	Name = "Infinite Jump",
	Default = false,
	Flag = "infJump",
}):Keybind({ Default = Enum.KeyCode.Space })

Movement:Toggle({
	Name = "Fly",
	Default = false,
	Flag = "fly",
}):Keybind({ Default = Enum.KeyCode.F })

Movement:Slider({
	Name = "Fly Speed",
	Min = 10, Max = 300, Default = 80,
	Flag = "flySpeed",
})


--=================================================================
-- VISUALS TAB
--=================================================================
local Visuals = VisualsTab:Section("World", "Left")

--[[
	DIVIDER. just a line.
	look, sometimes a section has a "theme change" and you want a
	visual break. that's what this is for.

	you can customize the color and thickness, i usually leave them
	default. subtle is good.
]]
Visuals:Divider()

Visuals:Toggle({
	Name = "Fullbright",
	Default = false,
	Flag = "fullbright",
	Callback = function(state)
		Lighting.Brightness    = state and 3 or 2
		Lighting.ClockTime     = state and 14 or 15
		Lighting.GlobalShadows = not state
	end,
}):Keybind({ Default = Enum.KeyCode.B })

Visuals:Toggle({
	Name = "Remove Fog",
	Default = false,
	Flag = "noFog",
	Callback = function(state)
		Lighting.FogEnd = state and 1e5 or 1000
	end,
})

Visuals:Divider({ Spacing = 12, Thickness = 2, Color = Color3.fromRGB(255, 100, 100) })

--[[
	STANDALONE COLOR PICKER. no toggle attached.
	just a labeled row with a swatch. use this when you've got a
	color setting that isn't tied to an on/off.
]]
Visuals:ColorPicker({
	Name = "Ambient Color",
	Default = Color3.fromRGB(128, 128, 128),
	Flag = "ambient",
	Callback = function(c) Lighting.Ambient = c end,
})

-- ── RIGHT: player ESP ──
local ESP = VisualsTab:Section("Player ESP", "Right")

ESP:Toggle({ Name = "Box ESP",     Default = false, Flag = "boxESP" })
	:ColorPicker({ Default = Color3.fromRGB(0, 255, 100) })

ESP:Toggle({ Name = "Name Tags",   Default = false, Flag = "nameTags" })
	:ColorPicker({ Default = Color3.fromRGB(255, 255, 255) })

ESP:Toggle({ Name = "Health Bars", Default = false, Flag = "healthBars" })

ESP:Toggle({ Name = "Tracers",     Default = false, Flag = "tracers" })
	:ColorPicker({ Default = Color3.fromRGB(255, 100, 100) })

ESP:Slider({
	Name = "Max Distance",
	Min = 50, Max = 5000, Default = 1500,
	Flag = "espDistance",
})

--[[
	MULTI-DROPDOWN.
	looks and behaves like a normal dropdown EXCEPT:
	  - clicking an option toggles it (the list stays open)
	  - you can select multiple
	  - selected items are tinted with the accent color

	the value label shows the first 2 selected, then "(+N)" for the rest.
	so 5 selections shows as "Enemies, NPCs (+3)".

	honestly the best use for these is a "what do you want to target"
	picker. way better than a row of checkboxes.
]]
ESP:MultiDropdown({
	Name = "Show For",
	Options = { "Enemies", "Teammates", "Friends", "Local Player", "Staff" },
	Default = { "Enemies", "Teammates" },
	Flag = "showFor",
	Callback = function(list)
		print("[show for]", table.concat(list, ", "))
	end,
})

--[[
	SINGLE DROPDOWN. classic.
	click an option, it selects, dropdown closes, done.

	if you need to update the option list at runtime (say, when a new
	player joins the game), use :Refresh() on the flag later. see the
	"flags" section at the bottom.
]]
ESP:Dropdown({
	Name = "Text Style",
	Options = { "Plain", "Outlined", "Shadowed", "Glowing" },
	Default = "Outlined",
	Flag = "textStyle",
})


--=================================================================
-- PLAYERS TAB
--=================================================================
--[[
	PLAYER LIST. this is Full-width only. it's the one element where
	"Left" or "Right" would make it unreadable, so always own tab.
]]
local PLSection = PlayersTab:Section("Player List", "Full")

--[[
	the player list has a bottom detail panel showing the selected
	player's info (avatar, user id, display name, account age) with
	TP and Spectate buttons.

	you hook those buttons up via callbacks:
	  OnTeleport(player)     — called when TP clicked
	  OnSpectate(player, on) — called when Spectate toggled

	i always check for the target's HumanoidRootPart before doing
	CFrame stuff, otherwise you get errors when they're dead or
	still loading in.
]]
PLSection:PlayerList({
	ShowDistance = true,     -- show "123m" next to each name
	RefreshRate  = 0.5,      -- refresh every half second
	Height       = 400,
	DetailHeight = 100,

	OnTeleport = function(target)
		local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		local tHrp  = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
		if myHrp and tHrp then
			myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3)
			Lunex:Notification({ Text = "TP'd to " .. target.Name, Duration = 2 })
		end
	end,

	OnSpectate = function(target, state)
		Lunex:Notification({
			Text = (state and "Watching " or "Stopped watching ") .. target.Name,
			Duration = 2,
		})
	end,
})


--=================================================================
-- INPUTS / LABELS SHOWCASE
--=================================================================
--[[
	i'm adding this as its own tab so you can SEE every input type
	in one place. in a real hub you'd sprinkle these through their
	relevant tabs, obviously.
]]
local InputsTab = Window:Tab("Inputs")

-- ── LEFT: text inputs and buttons ──
local TextStuff = InputsTab:Section("Text & Buttons", "Left")

--[[
	TEXT BOX. fires Callback when you click away or press enter.
	the :GetText() method lets you read the value at any time.
]]
local nameBox = TextStuff:TextBox({
	Name = "Your Name",
	Default = "",
	Placeholder = "type here...",
	Flag = "userName",
	Callback = function(text) print("[name]", text) end,
})

TextStuff:Button({
	Name = "Greet Me",
	Callback = function()
		local name = nameBox:GetText()
		if name and name ~= "" then
			Lunex:Notification({ Text = "hey " .. name .. "!", Duration = 3 })
		else
			Lunex:Notification({ Text = "enter a name first silly", Duration = 3 })
		end
	end,
})

--[[
	BUTTON. one of the few elements that has no state. click, thing
	happens. you get a click ripple for free.
]]
TextStuff:Button({
	Name = "Copy Job ID",
	Callback = function()
		if setclipboard then
			setclipboard(tostring(game.JobId))
			Lunex:Notification({ Text = "copied!", Duration = 2 })
		end
	end,
})

TextStuff:Divider()

--[[
	LABEL. static text.
	honestly the most underrated element. useful for headers,
	descriptions, section notes, etc.
]]
TextStuff:Label({ Name = "These are labels:" })
TextStuff:Label({ Name = "Left-aligned (default)" })

TextStuff:Label({
	Name = "Centered with a custom color",
	Center = true,
	Color = Color3.fromRGB(200, 160, 255),
})

--[[
	LABEL + COLOR PICKER.
	chained the same way as toggle + picker. when you've got a color
	with no on/off state, this is the play.
]]
TextStuff:Label({ Name = "Accent Color" }):ColorPicker({
	Default = Color3.fromRGB(200, 68, 240),
	Flag = "accentColor",
})

--[[
	LABEL + KEYBIND.
	unlike the toggle keybind, pressing the bound key does NOTHING by
	default. labels have no state.

	you MUST provide an OnTrigger function if you want the key to
	actually do something.
]]
TextStuff:Label({ Name = "Panic Key" }):Keybind({
	Default = Enum.KeyCode.P,
	OnTrigger = function()
		Lunex:Notification({ Text = "panic!", Duration = 2 })
	end,
})

-- ── RIGHT: programmatic stuff ──
local Prog = InputsTab:Section("Programmatic", "Right")

--[[
	here's the thing that trips people up:

	Library.Flags[name] gives you a live reference to whatever element
	you gave that Flag to. you can read or write its state from anywhere.

	here's what each element exposes:
	  Toggle:      :Get() → bool        :Set(bool)
	  Slider:      :Get() → number      :Set(number)
	  Dropdown:    :Get() → string      :Set(string)  :Refresh({...})
	  MultiDrop:   :Get() → list        :Set(list)  :Toggle(opt)  :IsSelected(opt)
	  ColorPicker: :Get() → Color3      :Set(Color3)
	  TextBox:     :GetText() → string  :SetText(str)

	that's IT. no OnChanged like Linoria has, so if you want reactive
	logic you use the Callback at creation time. which is honestly
	cleaner anyway.
]]
Prog:Button({
	Name = "Force-enable Aimbot",
	Callback = function()
		Lunex.Flags["aimbotEnabled"]:Set(true)
		Lunex:Notification({ Text = "aimbot forced on", Duration = 2 })
	end,
})

Prog:Button({
	Name = "Set FOV to 300",
	Callback = function()
		Lunex.Flags["fov"]:Set(300)
	end,
})

Prog:Button({
	Name = "Swap target list",
	Callback = function()
		-- you can replace a dropdown's option list on the fly
		Lunex.Flags["textStyle"]:Refresh({ "Fancy", "Simple", "Minimal", "Loud" })
		Lunex:Notification({ Text = "list refreshed", Duration = 2 })
	end,
})

Prog:Button({
	Name = "Randomize accent",
	Callback = function()
		Lunex.Flags["accentColor"]:Set(Color3.fromHSV(math.random(), 1, 1))
	end,
})


--=================================================================
-- CONFIGS + THEMES
--=================================================================
--[[
	i always give these their OWN tabs. here's why:

	- Configs has a name box, a dropdown of saved files, and 3 buttons.
	  That's a whole workflow. Mixing it with anything else feels cramped.

	- Themes has 9 color pickers. NINE. Give it its own space.

	both are "Full" width by default. if you want them side by side
	in the SAME tab (Configs on left, Themes on right), you can pass
	"Left" and "Right" to them. i usually don't, but it's a thing.
]]

--[[
	CONFIGS.
	each save writes a plaintext .cfg file with two sections:
	  [Theme]  — every color in Library.Theme
	  [Flags]  — every registered flag and its current value

	the file is human-readable. you can open it in notepad and
	hand-edit stuff if you want. here's what it looks like:

	    # Lunex configuration
	    # Name: PVP
	    # Saved: 2025-01-15 14:22:01

	    [Theme]
	    Accent = c:200,68,240
	    Background = c:16,16,16
	    ...

	    [Flags]
	    aimbotEnabled = b:true
	    fov           = n:120
	    showFor       = t:Enemies|Teammates

	the "c:" "b:" "n:" "s:" "t:" prefixes are type markers. c=color,
	b=bool, n=number, s=string, t=table. you can hand-edit these but
	be careful with the format — the loader is strict about it.
]]
ConfigTab:Configs("Full")

--[[
	THEMES.
	nine color pickers that update every element live. drag one and
	watch the whole UI recolour in real time.

	the nine colors:
	  Accent            — the purple (or whatever) highlights
	  Background        — the main window body
	  DarkBackground    — nested panels, dropdowns
	  HeaderBar         — section header bars
	  Text              — primary text
	  InactiveText      — greyed-out text
	  Outline           — the 1px outer border
	  Inline            — the 1px inner border
	  SectionBackground — slider tracks, toggle boxes

	if you want to really customize things, poke at these. the default
	theme is fine but sometimes you want a pink hub. no judgment.
]]
ThemeTab:Themes("Full")


--=================================================================
-- REAL LOGIC (tying flags to actual behavior)
--=================================================================
--[[
	ok so this is the part that matters. the UI gives you the controls,
	but YOU have to make them do things.

	trick i use: override the flag's Set method. here's how.

	when the library creates a toggle, it stores a "Set" function in
	Library.Flags[name]. every click from the UI calls that function.

	if i REPLACE that function with my own, now both UI clicks AND
	programmatic :Set() calls run my code. clean.
]]
local flyConnection, flyBodyVelocity, flyBodyGyro

Lunex.Flags["fly"].Set = function(state)
	-- always clean up first, otherwise you leak connections
	if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
	if flyBodyVelocity then flyBodyVelocity:Destroy(); flyBodyVelocity = nil end
	if flyBodyGyro     then flyBodyGyro:Destroy();     flyBodyGyro     = nil end

	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	if state then
		flyBodyVelocity = Instance.new("BodyVelocity")
		flyBodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
		flyBodyVelocity.Velocity = Vector3.zero
		flyBodyVelocity.Parent   = hrp

		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		flyBodyGyro.P = 1000
		flyBodyGyro.Parent = hrp

		flyConnection = RunService.Heartbeat:Connect(function()
			local cam  = workspace.CurrentCamera
			local move = Vector3.zero
			local speed = Lunex.Flags["flySpeed"]:Get()

			-- WASD relative to camera direction. the standard fly setup
			if UIS:IsKeyDown(Enum.KeyCode.W) then move = move + cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then move = move - cam.CFrame.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then move = move - cam.CFrame.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then move = move + cam.CFrame.RightVector end

			if move.Magnitude > 0 then move = move.Unit end
			flyBodyVelocity.Velocity = move * speed
			flyBodyGyro.CFrame = cam.CFrame
		end)
	end
end

--[[
	and here's the same trick for infinite jump. different approach
	here — I'm hooking the JumpRequest event instead of overriding a
	flag's Set method. this one is simpler because I don't need to
	clean up physics objects.
]]
local jumpConn

Lunex.Flags["infJump"].Set = function(state)
	if jumpConn then jumpConn:Disconnect(); jumpConn = nil end
	if state then
		jumpConn = UIS.JumpRequest:Connect(function()
			local char = LP.Character
			local hum  = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	end
end


--=================================================================
-- FINAL NOTES
--=================================================================
--[[
	few things i learned the hard way:

	1. ALWAYS give toggles/sliders/dropdowns a Flag. every one. even
	   if you don't need it now, you'll want to config-save it later.

	2. Never mix Full sections with Left/Right in the same tab. i know
	   i've said this three times. i mean it.

	3. When you override a flag's Set (like I did for fly), make sure
	   you clean up connections first. leaking connections is how
	   scripts die in the middle of a session.

	4. The config system saves EVERY flag that's registered. If you're
	   testing something and want it excluded, don't give it a Flag.

	5. Notifications should be SHORT. "Loaded!" not "The script has
	   finished loading and is ready for use". nobody reads those.
]]

Lunex:Notification({ Text = "All set. F for fly.", Duration = 5 })

print("[myhub] loaded")
print("[myhub] config folder: " .. Lunex:GetConfigFolder())
print("[myhub] tabs: main, visuals, players, inputs, configs, theme")
